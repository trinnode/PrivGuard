# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database
# Local (PostgreSQL): use DB_* below. On Vercel/Neon, set DATABASE_URL instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_NAME=ragnar_db
DB_USER=ragnar_user
DB_PASSWORD=ragnar_pass
DB_HOST=localhost
DB_PORT=5432

# UploadThing (evidence storage on serverless). When either token is set,
# evidence uploads go to UploadThing; otherwise local MEDIA_ROOT is used.
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_CDN_URL=https://utfs.io/f

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
